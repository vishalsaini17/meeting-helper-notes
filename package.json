{
  "name": "meeting-note-helper",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Windows Markdown editor for meeting notes.",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:win:portable": "npm run build && electron-builder --win portable --x64",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/newsreader": "^5.2.6",
    "@milkdown/crepe": "^7.22.3"
  },
  "overrides": {
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.30",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.meetingnotehelper.desktop",
    "productName": "Meeting Note Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meeting Note Helper",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  }
}
